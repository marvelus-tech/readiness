{
  "name": "readiness",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-02",
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "readiness-db",
      // Local development uses local D1
      // Production: Replace with actual database_id after running: wrangler d1 create readiness-db
      "database_id": "local"
    }
  ],
  "vars": {
    "STRIPE_PUBLISHABLE_KEY": "pk_test_placeholder"
  }
}
